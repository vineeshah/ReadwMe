generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                @id @default(cuid())
  name                String?
  email               String?               @unique
  emailVerified       DateTime?
  image               String?
  spotifyToken        String?
  spotifyRefreshToken String?
  spotifyTokenExpiry  DateTime?
  accounts            Account[]
  books               Book[]
  messages            Message[]
  sessions            Session[]
  genrePrefs          UserGenrePreference[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Book {
  id          String      @id @default(cuid())
  name        String
  author      String
  userId      String
  publishDate DateTime
  user        User        @relation(fields: [userId], references: [id])
  genres      BookGenre[]
}

model Message {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  bookName  String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Genre {
  id        Int                   @id @default(autoincrement())
  name      String                @unique
  books     BookGenre[]
  userPrefs UserGenrePreference[]
}

model BookGenre {
  bookId  String
  genreId Int
  weight  Float  @default(1.0)
  book    Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id])

  @@id([bookId, genreId])
}

model UserGenrePreference {
  userId  String
  genreId Int
  weight  Float  @default(1.0)
  genre   Genre  @relation(fields: [genreId], references: [id])
  user    User   @relation(fields: [userId], references: [id])

  @@id([userId, genreId])
}
